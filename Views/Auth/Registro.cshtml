@model RegistroViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear Cuenta - MiEspacio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            display: flex; align-items: center; justify-content: center;
        }
        .auth-card {
            max-width: 480px; width: 100%; border: 1px solid #dbdbdb;
            border-radius: 16px; background: #fff;
        }
        .btn-ig {
            background: linear-gradient(45deg, #e1306c, #c13584);
            border: none; color: #fff; font-weight: 600;
        }
        .btn-ig:hover { opacity: 0.92; color: #fff; }
        .req-list { list-style: none; padding-left: 0; font-size: 0.8rem; }
        .req-ok { color: #198754; font-weight: 600; }
        .req-pending { color: #6c757d; }
        .validation-summary-valid { display: none; }
    </style>
</head>
<body class="p-3">

<div class="auth-card shadow-sm p-4 p-md-5 my-3">
    <div class="text-center mb-4">
        <h3 class="fw-bold mb-1">Crea tu cuenta</h3>
        <p class="text-muted small mb-0">Únete y personaliza tu propio espacio</p>
    </div>

    <form asp-action="Registro" method="post" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label small fw-semibold">Nombre completo</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Randy Tovar" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NombreUsuario" class="form-label small fw-semibold">Nombre de usuario</label>
            <div class="input-group">
                <span class="input-group-text bg-light">@@</span>
                <input asp-for="NombreUsuario" class="form-control" placeholder="ej. randy.tovar" />
            </div>
            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Correo" class="form-label small fw-semibold">Correo electrónico real</label>
            <input asp-for="Correo" class="form-control" placeholder="tu.correo@gmail.com" />
            <span asp-validation-for="Correo" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Telefono" class="form-label small fw-semibold">Teléfono con WhatsApp</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-success"><i class="bi bi-whatsapp"></i></span>
                <input asp-for="Telefono" id="inputTelefono" class="form-control" placeholder="+50255551234" />
                <a id="btnTestWa" href="#" target="_blank" class="btn btn-outline-success disabled" title="Verificar en WhatsApp">
                    Probar
                </a>
            </div>
            <small class="text-muted">Incluye código de país sin espacios (ej. +502 para Guatemala).</small><br />
            <span asp-validation-for="Telefono" class="text-danger small"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Contrasena" class="form-label small fw-semibold">Contraseña robusta</label>
            <input asp-for="Contrasena" id="inputPass" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="Contrasena" class="text-danger small"></span>
        </div>

        <ul class="req-list mb-3">
            <li id="rLen" class="req-pending"><i class="bi bi-circle me-1"></i> Mínimo 8 caracteres</li>
            <li id="rMay" class="req-pending"><i class="bi bi-circle me-1"></i> Al menos una letra mayúscula</li>
            <li id="rMin" class="req-pending"><i class="bi bi-circle me-1"></i> Al menos una letra minúscula</li>
            <li id="rNum" class="req-pending"><i class="bi bi-circle me-1"></i> Al menos un número</li>
            <li id="rSim" class="req-pending"><i class="bi bi-circle me-1"></i> Al menos un símbolo (@@$!%*?&.#_-)</li>
        </ul>

        <div class="mb-4">
            <label asp-for="ConfirmarContrasena" class="form-label small fw-semibold">Confirmar contraseña</label>
            <input asp-for="ConfirmarContrasena" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-ig w-100 py-2 rounded-3">Registrarme</button>
    </form>

    <hr class="my-4" />
    <p class="text-center small mb-0 text-muted">
        ¿Ya tienes cuenta?
        <a asp-action="Login" class="fw-semibold text-decoration-none" style="color:#c13584;">Inicia sesión</a>
    </p>
</div>

<script>
    const inputPass = document.getElementById('inputPass');
    const reglas = [
        { id: 'rLen', test: v => v.length >= 8 },
        { id: 'rMay', test: v => /[A-Z]/.test(v) },
        { id: 'rMin', test: v => /[a-z]/.test(v) },
        { id: 'rNum', test: v => /\d/.test(v) },
        { id: 'rSim', test: v => /[$!%*?&.#_\-\x40]/.test(v) }
    ];

    inputPass.addEventListener('input', () => {
        const val = inputPass.value;
        reglas.forEach(r => {
            const el = document.getElementById(r.id);
            const ok = r.test(val);
            el.className = ok ? 'req-ok' : 'req-pending';
            el.querySelector('i').className = ok ? 'bi bi-check-circle-fill me-1' : 'bi bi-circle me-1';
        });
    });

    const inputTel = document.getElementById('inputTelefono');
    const btnWa = document.getElementById('btnTestWa');
    inputTel.addEventListener('input', () => {
        const limpio = inputTel.value.replace(/\D/g, '');
        if (/^\+[1-9]\d{7,14}$/.test(inputTel.value.trim())) {
            btnWa.href = `https://wa.me/${limpio}`;
            btnWa.classList.remove('disabled');
        } else {
            btnWa.href = '#';
            btnWa.classList.add('disabled');
        }
    });
</script>
</body>
</html>