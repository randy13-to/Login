@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - MiEspacio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            display: flex; align-items: center; justify-content: center;
        }
        .auth-card {
            max-width: 410px; width: 100%; border: 1px solid #dbdbdb;
            border-radius: 16px; background: #fff;
        }
        .brand-logo {
            background: linear-gradient(45deg, #f09433, #dc2743, #bc1888);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .btn-ig {
            background: linear-gradient(45deg, #e1306c, #c13584);
            border: none; color: #fff; font-weight: 600;
        }
        .btn-ig:hover { opacity: 0.92; color: #fff; }
    </style>
</head>
<body class="p-3">

<div class="auth-card shadow-sm p-4 p-md-5">
    <div class="text-center mb-4">
        <i class="bi bi-camera2 fs-1 brand-logo"></i>
        <h2 class="fw-bold mt-1 mb-0">MiEspacio</h2>
        <p class="text-muted small">Inicia sesión para entrar a tu espacio</p>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success small py-2">
            <i class="bi bi-check-circle me-1"></i> @TempData["Exito"]
        </div>
    }

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

        <div class="mb-3">
            <label asp-for="Identificador" class="form-label small fw-semibold">Usuario o Correo electrónico</label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                <input asp-for="Identificador" class="form-control" placeholder="ej. randy.dev o correo@gmail.com" />
            </div>
            <span asp-validation-for="Identificador" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Contrasena" class="form-label small fw-semibold">Contraseña</label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                <input asp-for="Contrasena" class="form-control" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Contrasena" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-ig w-100 py-2 rounded-3">Entrar</button>
    </form>

    <hr class="my-4" />
    <p class="text-center small mb-0 text-muted">
        ¿Aún no tienes cuenta?
        <a asp-action="Registro" class="fw-semibold text-decoration-none" style="color:#c13584;">Regístrate aquí</a>
    </p>
</div>

</body>
</html>