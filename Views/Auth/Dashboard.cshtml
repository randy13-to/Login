@{
    Layout = null;
    var nombreCompleto = User.FindFirst("NombreCompleto")?.Value ?? "Integrante";
    var nombreUsuario = User.Identity?.Name ?? "usuario";
    var inicial = string.IsNullOrWhiteSpace(nombreCompleto) ? "U" : nombreCompleto.Substring(0, 1).ToUpper();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Espacio - @("@" + nombreUsuario)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background-color: #fafafa; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        .ig-navbar { background: #fff; border-bottom: 1px solid #dbdbdb; }
        .ig-ring {
            background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
            padding: 3px; border-radius: 50%; display: inline-block;
        }
        .ig-avatar {
            width: 60px; height: 60px; border-radius: 50%; background: #fff;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 1.4rem; color: #262626; border: 2px solid #fff;
        }
        .ig-card { border: 1px solid #dbdbdb; border-radius: 14px; overflow: hidden; background: #fff; }
        .carousel-item img { height: 430px; object-fit: cover; }
        .btn-like.liked { color: #ed4956 !important; }
    </style>
</head>
<body>

<nav class="navbar ig-navbar sticky-top px-3 py-2">
    <div class="container" style="max-width: 720px;">
        <span class="navbar-brand fw-bold fs-4 mb-0">
            <i class="bi bi-camera2 me-1 text-danger"></i> MiEspacio
        </span>
        <div class="d-flex align-items-center gap-3">
            <span class="fw-semibold text-dark d-none d-sm-inline">@("@" + nombreUsuario)</span>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                </button>
            </form>
        </div>
    </div>
</nav>

<main class="container py-4" style="max-width: 650px;">
    <!-- Tarjeta de bienvenida personalizada -->
    <div class="ig-card p-4 mb-4 d-flex align-items-center gap-3 shadow-sm">
        <div class="ig-ring">
            <div class="ig-avatar">@inicial</div>
        </div>
        <div>
            <h4 class="fw-bold mb-1">¡Bienvenido a tu espacio, @nombreCompleto!</h4>
            <p class="text-muted small mb-1">
                Conectado como <strong class="text-dark">@("@" + nombreUsuario)</strong>
            </p>
            <p id="fraseBonita" class="mb-0 fst-italic text-secondary small">
                "Cada gran proyecto empieza con una buena idea y el valor de dar el primer paso."
            </p>
        </div>
    </div>

    <!-- Feed estilo Instagram con galería cambiante -->
    <div class="ig-card shadow-sm mb-4">
        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill text-bg-dark">@("@" + nombreUsuario)</span>
                <small class="text-muted">Galería inspiradora</small>
            </div>
            <i class="bi bi-three-dots text-muted"></i>
        </div>

        <div id="igCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3500">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#igCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#igCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#igCarousel" data-bs-slide-to="2"></button>
                <button type="button" data-bs-target="#igCarousel" data-bs-slide-to="3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="https://picsum.photos/id/1015/900/700" class="d-block w-100" alt="Paisaje 1">
                </div>
                <div class="carousel-item">
                    <img src="https://picsum.photos/id/1018/900/700" class="d-block w-100" alt="Paisaje 2">
                </div>
                <div class="carousel-item">
                    <img src="https://picsum.photos/id/1039/900/700" class="d-block w-100" alt="Paisaje 3">
                </div>
                <div class="carousel-item">
                    <img src="https://picsum.photos/id/1043/900/700" class="d-block w-100" alt="Paisaje 4">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#igCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#igCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>

        <div class="p-3">
            <div class="d-flex gap-3 fs-4 mb-2 align-items-center">
                <button id="btnLike" class="btn btn-link p-0 text-dark btn-like" title="Me gusta">
                    <i class="bi bi-heart"></i>
                </button>
                <i class="bi bi-chat"></i>
                <i class="bi bi-send"></i>
                <i class="bi bi-bookmark ms-auto"></i>
            </div>
            <p class="mb-1 fw-semibold small"><span id="likeCount">24</span> Me gusta</p>
            <p class="mb-0 small">
                <strong>@("@" + nombreUsuario)</strong> Disfrutando un nuevo día para crear cosas increíbles. ✨
            </p>
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const frases = [
        '"Cada gran proyecto empieza con una buena idea y el valor de dar el primer paso."',
        '"Haz hoy algo de lo que tu yo del futuro se sienta orgulloso."',
        '"La constancia convierte lo difícil en cotidiano."',
        '"Tu espacio, tu ritmo, tus metas. ¡Qué alegría verte por aquí!"'
    ];
    let i = 0;
    setInterval(() => {
        i = (i + 1) % frases.length;
        document.getElementById('fraseBonita').textContent = frases[i];
    }, 5000);

    const btnLike = document.getElementById('btnLike');
    const likeCount = document.getElementById('likeCount');
    btnLike.addEventListener('click', () => {
        btnLike.classList.toggle('liked');
        const activo = btnLike.classList.contains('liked');
        btnLike.querySelector('i').className = activo ? 'bi bi-heart-fill' : 'bi bi-heart';
        likeCount.textContent = activo ? '25' : '24';
    });
</script>
</body>
</html>